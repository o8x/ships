{
  "name": "ships",
  "version": "3.17.0",
  "description": "A macOS menu bar toolbox for developers.",
  "author": "Ships",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "pnpm run build:css",
    "build:css": "tailwindcss -i ./src/renderer/styles/tailwind.css -o ./src/renderer/styles/tailwind.build.css --minify",
    "watch:css": "tailwindcss -i ./src/renderer/styles/tailwind.css -o ./src/renderer/styles/tailwind.build.css --watch",
    "start": "pnpm run build:css && electron .",
    "dev": "electron .",
    "dist:mac": "bash scripts/dist-mac.sh",
    "pack:mac": "pnpm run build:css && electron-builder --mac --arm64 --dir"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-liquid-glass": "^1.1.1",
    "electron-updater": "^6.8.9",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.1",
    "asarmor": "^3.0.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.4.19"
  },
  "ships": {
    "showDockIcon": false,
    "window": {
      "width": 380,
      "height": 500,
      "gapBelowTray": 2,
      "cornerRadius": 10
    },
    "settingsWindow": {
      "width": 800,
      "height": 600
    },
    "terminalWindow": {
      "width": 1024,
      "height": 768,
      "minWidth": 350,
      "minHeight": 200,
      "alwaysOnTop": true,
      "scrollback": 10000,
      "hotkey": "CommandOrControl+Shift+Z",
      "closeAction": "destroy",
      "fontSize": 12,
      "shell": "",
      "ballSize": 75,
      "ballEnabled": true,
      "ballDelayMs": 200,
      "ballIcon": "ball.svg",
      "ballDark": true
    },
    "sshBuiltinTerminal": true,
    "sftpDownloadDir": "~/Downloads",
    "cdHistoryMax": 10,
    "logRetentionDays": 7,
    "fileWindow": {
      "width": 900,
      "height": 600,
      "minWidth": 480,
      "minHeight": 320,
      "alwaysOnTop": true
    },
    "updateWindow": {
      "width": 380,
      "height": 184
    },
    "defaultLocale": "zh",
    "defaultTheme": "system",
    "defaultAccent": "#2e6bfc"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "build": {
    "appId": "com.ships.app",
    "productName": "Ships",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "o8x",
        "repo": "ships"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "src/main/scripts/*",
      "node_modules/electron-liquid-glass/**"
    ],
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "zh_CN"
    ],
    "afterSign": "scripts/notarize.cjs",
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/imgs/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSLocalNetworkUsageDescription": "Ships 需要访问本地网络以探测和连接你的 SSH 主机。"
      },
      "artifactName": "${productName}-v${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": true,
      "artifactName": "${productName}-v${version}-${arch}.${ext}",
      "title": "${productName} v${version}"
    }
  }
}
