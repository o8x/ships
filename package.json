{
  "name": "ships",
  "version": "0.3.0",
  "description": "A macOS menu bar toolbox for developers.",
  "author": "Ships",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "pnpm run build:css",
    "build:css": "tailwindcss -i ./src/renderer/styles/tailwind.css -o ./src/renderer/styles/tailwind.build.css --minify",
    "watch:css": "tailwindcss -i ./src/renderer/styles/tailwind.css -o ./src/renderer/styles/tailwind.build.css --watch",
    "start": "pnpm run build:css && electron .",
    "dev": "electron .",
    "dist:mac": "pnpm run build:css && electron-builder --mac --arm64",
    "pack:mac": "pnpm run build:css && electron-builder --mac --arm64 --dir"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.4.19"
  },
  "ships": {
    "showDockIcon": false,
    "window": {
      "width": 400,
      "height": 500,
      "gapBelowTray": 6,
      "cornerRadius": 12
    },
    "settingsWindow": {
      "width": 720,
      "height": 520
    },
    "defaultLocale": "zh",
    "defaultTheme": "system",
    "defaultAccent": "#2e6bfc"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "build": {
    "appId": "com.ships.app",
    "productName": "Ships",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/imgs/icon.icns",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "${productName}-v${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-v${version}-${arch}.${ext}",
      "title": "${productName} v${version}"
    }
  }
}
