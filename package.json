{
  "name": "vessel",
  "version": "4.12.0",
  "description": "A macOS menu bar toolbox for developers.",
  "author": "Vessel",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "pnpm run build:css",
    "build:css": "tailwindcss -i ./src/renderer/styles/tailwind.css -o ./src/renderer/styles/tailwind.build.css --minify",
    "watch:css": "tailwindcss -i ./src/renderer/styles/tailwind.css -o ./src/renderer/styles/tailwind.build.css --watch",
    "start": "pnpm run build:css && electron .",
    "dev": "electron .",
    "dist:mac": "bash scripts/dist-mac.sh",
    "pack:mac": "pnpm run build:css && electron-builder --mac --arm64 --dir"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bwip-js": "^4.11.4",
    "electron-liquid-glass": "^1.1.1",
    "electron-updater": "^6.8.9",
    "qrcode-generator": "^2.0.4",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.1",
    "asarmor": "^3.0.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.4.19"
  },
  "vessel": {
    "showDockIcon": false,
    "window": {
      "width": 380,
      "height": 500,
      "gapBelowTray": 2,
      "cornerRadius": 10
    },
    "mainWindow": {
      "width": 640,
      "height": 480
    },
    "settingsWindow": {
      "width": 800,
      "height": 600
    },
    "terminalWindow": {
      "width": 1024,
      "height": 768,
      "minWidth": 350,
      "minHeight": 200,
      "alwaysOnTop": true,
      "scrollback": 10000,
      "hotkey": "CommandOrControl+Shift+Z",
      "closeAction": "destroy",
      "fontSize": 14,
      "shell": "",
      "fontFamily": "",
      "ballSize": 90,
      "ballEnabled": true,
      "ballDelayMs": 50,
      "ballIcon": "ball-11.svg",
      "ballDark": true,
      "ballTransparent": true
    },
    "sshBuiltinTerminal": true,
    "sftpDownloadDir": "~/Downloads",
    "cdHistoryMax": 10,
    "logRetentionDays": 7,
    "fileWindow": {
      "width": 900,
      "height": 600,
      "minWidth": 480,
      "minHeight": 320,
      "alwaysOnTop": false
    },
    "updateWindow": {
      "width": 380,
      "height": 150
    },
    "defaultLocale": "zh",
    "defaultTheme": "system",
    "defaultAccent": "#2e6bfc",
    "updateRepo": {
      "owner": "o8x",
      "repo": "vessel"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "build": {
    "appId": "cn.com.stdout.vessel",
    "productName": "Vessel",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "o8x",
        "repo": "vessel"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "src/main/scripts/*",
      "node_modules/electron-liquid-glass/**"
    ],
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "zh_CN"
    ],
    "afterSign": "scripts/notarize.cjs",
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "pkg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/imgs/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSLocalNetworkUsageDescription": "Vessel 需要访问本地网络以探测和连接你的 SSH 主机。"
      },
      "artifactName": "${productName}-v${version}-${arch}.${ext}"
    },
    "pkg": {
      "scripts": "../scripts/pkg-scripts",
      "installLocation": "/Applications",
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": true,
      "isRelocatable": false,
      "mustClose": [
        "Vessel",
        "Ships"
      ],
      "artifactName": "${productName}-v${version}-${arch}.${ext}"
    }
  }
}
